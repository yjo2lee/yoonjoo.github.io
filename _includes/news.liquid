{% comment %}
  Local override of al_folio_core's _includes/news.liquid.
  Changes from the theme:
  - The date column shows month and year only ("Aug 2026") — the day parts in
    the news front matter are placeholders used as sort keys, so showing them
    would imply a precision the data doesn't have.
  - The list is capped at 20rem tall and scrolls vertically past that; the
    theme sets a max-height but never an overflow, so it clipped instead of
    scrolling.
  - Bold text inside a news link keeps the link color -- the theme forces
    `strong` to the plain text color, which turned such links black.
{% endcomment %}

<style>
  .news a strong {
    color: inherit;
  }

  .news .table-responsive {
    max-height: 20rem;
    overflow-y: auto;
  }

  .news th.news-date {
    width: 6.5rem;
    font-weight: 400;
    color: var(--global-text-color-light, var(--global-text-color));
    white-space: nowrap;
  }
</style>

<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" class="news-date">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
