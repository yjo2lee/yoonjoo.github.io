{% comment %}
  Local override of al_folio_core's _includes/selected_papers.liquid.

  Adds the research-area filter pills above the selected publications. The pill
  bar, its styling and its behaviour all live in _includes/area_filter.liquid,
  shared with the full list on /publications/. Area tags live in
  _data/paper_areas.yml, keyed by bib key, so editing that file is enough.
{% endcomment %}

<div class="publications selected-papers" data-paper-areas="{{ site.data.paper_areas | jsonify | escape }}">
  {% include area_filter.liquid %}

  {% bibliography --group_by none --query @*[selected=true]* %}

  <p class="area-empty" hidden>No selected publications in this area.</p>
</div>
